@{
    ViewData["Title"] = "แดชบอร์ด";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">แดชบอร์ด</h2>
            <p class="text-muted mb-0">
                <i class="bi bi-calendar3 me-1"></i>
                วันศุกร์ที่ 20 พฤศจิกายน 2569 · อัปเดตล่าสุด 07:30 น.
            </p>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <button class="btn btn-outline-primary btn-sm">
                <i class="bi bi-arrow-clockwise me-1"></i>รีเฟรช
            </button>
            <button class="btn btn-primary btn-sm">
                <i class="bi bi-send me-1"></i>ส่งสรุป LINE ทันที
            </button>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card stat-card critical h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon">
                        <i class="bi bi-exclamation-octagon-fill"></i>
                    </div>
                    <div>
                        <div class="fs-3 fw-bold text-danger">3</div>
                        <div class="text-muted small">วิกฤต / หมดอายุ</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card high h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                    <div>
                        <div class="fs-3 fw-bold" style="color:#b58100">7</div>
                        <div class="text-muted small">ใกล้หมดอายุ ≤30 วัน</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card medium h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon">
                        <i class="bi bi-cart-plus"></i>
                    </div>
                    <div>
                        <div class="fs-3 fw-bold text-primary">5</div>
                        <div class="text-muted small">ถึงจุดสั่งซื้อ</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card info h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon">
                        <i class="bi bi-box"></i>
                    </div>
                    <div>
                        <div class="fs-3 fw-bold text-success">4</div>
                        <div class="text-muted small">ยาค้างสต็อก</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left: Alerts -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 pt-3 pb-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="section-title mb-0">
                            <i class="bi bi-bell text-primary"></i>
                            การแจ้งเตือนที่ต้องดำเนินการ
                        </h5>
                        <a href="#" class="btn btn-sm btn-link">ดูทั้งหมด</a>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table alert-table mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">ระดับ</th>
                                    <th>ยา / ล็อต</th>
                                    <th>รายละเอียด</th>
                                    <th>คงเหลือ</th>
                                    <th class="pe-4 text-end">การดำเนินการ</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Critical: Expired -->
                                <tr class="alert-row-critical">
                                    <td class="ps-4">
                                        <span class="badge badge-critical">วิกฤต</span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">Paracetamol 500 mg</div>
                                        <div class="text-muted small">Lot A123 · หมดอายุ 10/11/2569</div>
                                    </td>
                                    <td>หมดอายุแล้ว ยังมีคงเหลือ</td>
                                    <td>200 เม็ด</td>
                                    <td class="pe-4 text-end">
                                        <button class="btn btn-sm btn-outline-danger">ทำลาย</button>
                                    </td>
                                </tr>
                                <!-- High: Expiring ≤30 -->
                                <tr class="alert-row-high">
                                    <td class="ps-4">
                                        <span class="badge badge-high">สูง</span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">Amoxicillin 500 mg</div>
                                        <div class="text-muted small">Lot B456 · หมดอายุ 31/12/2569 (อีก 18 วัน)</div>
                                    </td>
                                    <td>ใกล้หมดอายุ ≤30 วัน</td>
                                    <td>500 แคปซูล</td>
                                    <td class="pe-4 text-end">
                                        <button class="btn btn-sm btn-outline-warning">จัดลำดับจ่าย</button>
                                    </td>
                                </tr>
                                <tr class="alert-row-high">
                                    <td class="ps-4">
                                        <span class="badge badge-high">สูง</span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">Metformin 500 mg</div>
                                        <div class="text-muted small">Lot C789 · หมดอายุ 05/01/2570 (อีก 23 วัน)</div>
                                    </td>
                                    <td>ใกล้หมดอายุ ≤30 วัน</td>
                                    <td>1,200 เม็ด</td>
                                    <td class="pe-4 text-end">
                                        <button class="btn btn-sm btn-outline-warning">จัดลำดับจ่าย</button>
                                    </td>
                                </tr>
                                <!-- Medium: Reorder -->
                                <tr class="alert-row-medium">
                                    <td class="ps-4">
                                        <span class="badge badge-medium">ปานกลาง</span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">Omeprazole 20 mg</div>
                                        <div class="text-muted small">ทุก Lot</div>
                                    </td>
                                    <td>ถึงจุดสั่งซื้อ (ROP 800)</td>
                                    <td class="text-danger fw-semibold">320 เม็ด</td>
                                    <td class="pe-4 text-end">
                                        <button class="btn btn-sm btn-outline-primary">สั่งซื้อ 1,680</button>
                                    </td>
                                </tr>
                                <tr class="alert-row-medium">
                                    <td class="ps-4">
                                        <span class="badge badge-medium">ปานกลาง</span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">Amlodipine 5 mg</div>
                                        <div class="text-muted small">ทุก Lot</div>
                                    </td>
                                    <td>ต่ำกว่า Min (Min 200)</td>
                                    <td class="text-danger fw-semibold">85 เม็ด</td>
                                    <td class="pe-4 text-end">
                                        <button class="btn btn-sm btn-outline-primary">สั่งซื้อ 915</button>
                                    </td>
                                </tr>
                                <!-- Slow moving -->
                                <tr>
                                    <td class="ps-4">
                                        <span class="badge badge-low">ค้างสต็อก</span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">Chlorpheniramine 4 mg</div>
                                        <div class="text-muted small">Lot D012</div>
                                    </td>
                                    <td>ไม่มีกิจกรรมเกิน 95 วัน</td>
                                    <td>1,500 เม็ด</td>
                                    <td class="pe-4 text-end">
                                        <button class="btn btn-sm btn-outline-secondary">ตรวจสอบ</button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right sidebar -->
        <div class="col-lg-4">
            <!-- Quick Actions -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="section-title">
                        <i class="bi bi-lightning text-warning"></i>
                        ทางลัด
                    </h5>
                    <div class="row g-3">
                        <div class="col-6">
                            <a href="#" class="quick-action">
                                <i class="bi bi-upc-scan text-primary"></i>
                                <span class="small fw-semibold">สแกนบาร์โค้ด</span>
                            </a>
                        </div>
                        <div class="col-6">
                            <a href="#" class="quick-action">
                                <i class="bi bi-file-earmark-arrow-up text-success"></i>
                                <span class="small fw-semibold">นำเข้า CSV</span>
                            </a>
                        </div>
                        <div class="col-6">
                            <a href="#" class="quick-action">
                                <i class="bi bi-box-arrow-in-down text-info"></i>
                                <span class="small fw-semibold">รับยาเข้า</span>
                            </a>
                        </div>
                        <div class="col-6">
                            <a href="#" class="quick-action">
                                <i class="bi bi-box-arrow-up text-danger"></i>
                                <span class="small fw-semibold">ตัดจ่าย</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Today's digest preview -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="section-title">
                        <i class="bi bi-chat-dots text-success"></i>
                        สรุปรายวัน (LINE)
                    </h5>
                    <div class="bg-light rounded-3 p-3 small" style="font-family: monospace; white-space: pre-line; line-height: 1.5;">
📋 สรุปคลังยา OPD 20/11/2569

🔴 หมดอายุแล้ว (1)
 • Paracetamol 500mg Lot A123
   หมดอายุ 10/11/2569 คงเหลือ 200

🔴 ใกล้หมดอายุ ≤30 วัน (2)
 • Amoxicillin 500mg Lot B456
   หมดอายุ 31/12/2569 (อีก 18 วัน)

🟡 ถึงจุดสั่งซื้อ (3)
 • Omeprazole 20mg คงเหลือ 320
   แนะนำสั่ง 1,680 เม็ด
                    </div>
                    <button class="btn btn-success btn-sm w-100 mt-3">
                        <i class="bi bi-send me-1"></i>ส่งเข้า LINE ตอนนี้
                    </button>
                </div>
            </div>

            <!-- Stock overview -->
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="section-title">
                        <i class="bi bi-pie-chart text-primary"></i>
                        ภาพรวมสต็อก
                    </h5>
                    <ul class="list-unstyled mb-0">
                        <li class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted">รายการยาทั้งหมด</span>
                            <span class="fw-semibold">248</span>
                        </li>
                        <li class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted">ล็อตที่ Active</span>
                            <span class="fw-semibold">412</span>
                        </li>
                        <li class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted">มูลค่าสต็อกโดยประมาณ</span>
                            <span class="fw-semibold">฿ 1.24 ล้าน</span>
                        </li>
                        <li class="d-flex justify-content-between py-2">
                            <span class="text-muted">ล็อตที่งดจ่าย (≤30 วัน)</span>
                            <span class="fw-semibold text-warning">18</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
